---
layout: base.njk
pagination:
  data: categories
  size: 1
  alias: category
permalink: "gallery/{{ category.slug }}/index.html"
needsGallery: true
eleventyComputed:
  title: "{{ category.title }}"
  description: "{{ category.description }}"
---
<div class="gal">
  <div class="gal-head">
    <h1 class="page-heading"{% if category.accent %} style="--cat-accent:{{ category.accent }};"{% endif %}><span class="dot"></span>{{ category.title }}</h1>
  </div>
  {% if category.description %}<p class="page-description">{{ category.description }}</p>{% endif %}
  <div class="justified-gallery">
    {% for photo in category.photos %}
      {% galleryItem photo %}
    {% endfor %}
  </div>
</div>
