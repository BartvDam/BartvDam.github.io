<div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Image viewer">
  <div class="lb-top">
    <span id="lb-count"></span>
    <button class="lb-x" id="lb-close" aria-label="Close">×</button>
  </div>
  <div class="lb-mid">
    <button class="lb-nav lb-prev" aria-label="Previous image">‹</button>
    <img id="lb-img" src="" alt="">
    <button class="lb-nav lb-next" aria-label="Next image">›</button>
  </div>
  <div class="lb-cap" id="lb-cap">
    <div class="lb-title" id="lb-title"></div>
    <p class="lb-blurb" id="lb-blurb"></p>
    <div class="lb-loc" id="lb-loc">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.4"></circle></svg>
      <span id="lb-loc-text"></span>
    </div>
    <div class="lb-specs" id="lb-specs"></div>
  </div>
</div>
