<header>
  <div class="wrap">
    <a class="brand" href="/">{{ site.name }}<span class="brand-tag">{{ site.tagline }}</span></a>
    <nav>
      <div class="menu">
        {% for category in categories %}
          <a href="/gallery/{{ category.slug }}/"{% if page.url == "/gallery/" + category.slug + "/" %} aria-current="true"{% endif %}>{{ category.title }}</a>
        {% endfor %}
        {% for item in site.nav %}
          <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="true"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </div>
      <button id="theme-toggle" aria-label="Switch color theme">dark</button>
    </nav>
  </div>
</header>
