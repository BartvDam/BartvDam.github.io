<header>
  <a class="brand" href="/">{{ site.name }}</a>
  <nav>
    <div class="menu">
      {% for item in site.nav %}
        {% set isActive = (page.url == item.url) or (item.url == "/" and page.url.startsWith("/gallery/")) %}
        <a href="{{ item.url }}"{% if isActive %} aria-current="true"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </div>
    <button id="theme-toggle" aria-label="Switch color theme">dark</button>
  </nav>
</header>
