{% macro icon(name) %}
{%- if name == "flickr" -%}
<svg viewBox="0 0 32 20" width="20" height="20" aria-hidden="true" focusable="false">
  <circle cx="10" cy="10" r="9" fill="currentColor"/>
  <circle cx="22" cy="10" r="9" fill="currentColor"/>
</svg>
{%- elif name == "instagram" -%}
<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6">
  <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/>
  <circle cx="12" cy="12" r="4.4"/>
  <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"/>
</svg>
{%- endif -%}
{% endmacro %}
